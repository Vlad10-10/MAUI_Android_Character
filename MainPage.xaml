<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HeroCreatorr.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
           <Label 
               Text = "Character Creator"
               FontSize="30"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               />
           <BoxView 
               HeightRequest="2"
               />
           <Label 
               Text="Dane postaci"
               FontSize="22"
               FontAttributes="Bold"
               />
           <Entry 
               Placeholder="Imie postaci"
               Text="{Binding Name, Mode=TwoWay}"
               />
           <Picker 
               Title="Wybierz klase "
               ItemsSource = "{Binding Classes}"
               SelectedItem="{Binding CharacterClass, Mode=TwoWay}"
               x:Name="picker">
              
           </Picker>               
           <Frame 
               Padding="20"
               BorderColor="Grey"
               CornerRadius="10">
               <VerticalStackLayout Spacing="10">
                   <Label 
                       Text="{Binding Name}"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                   />
                   <Label 
                       Text="{Binding CharacterClass}"
                       HorizontalOptions="Center"
                       FontSize="15"
                       />
                   <Label 
                       Text="{Binding Level, StringFormat= 'Level: 0{F:0}'}"
                       HorizontalOptions="Center"
                   />
                   
               </VerticalStackLayout>
           </Frame>
           
           <Label 
               Text="{Binding Level, StringFormat='{0:F0}'}"
               FontSize="20"
               FontAttributes="Bold"
               />
           <Slider 
               Minimum="1"
               Maximum="50"
               Value="{Binding Level, Mode=TwoWay}"
               
               />
           
           <Label 
               Text="Statystyki"
               FontSize="22"
               FontAttributes="Bold"
               />
           <Label Text="{Binding Strength, StringFormat='{0:F0}'}"/>
           <Slider
               Minimum="1"
               Maximum="100"
               Value="{Binding Strength, Mode=TwoWay}"
           />
           <Label Text="{Binding Dexterity, StringFormat='{0:F0}'}"/>
           <Slider
               Minimum="1"
               Maximum="100"
               Value="{Binding Dexterity, Mode=TwoWay}"
           />
           <Label Text="{Binding Intelligence, StringFormat='{0:F0}'}"/>
           <Slider
               Minimum="1"
               Maximum="100"
               Value="{Binding Intelligence, Mode=TwoWay}"
           />  
           
           <Frame 
               Padding="20"
               BorderColor="Gray"
               CornerRadius="15">
               <VerticalStackLayout Spacing="10">
               <Label Text="Summary" 
                      FontSize="20"
                      FontAttributes="Bold"
                      HorizontalOptions="Center"
                      />
               <Label Text="{Binding Strength, StringFormat='{0:F0}'}"/>
               <Label Text="{Binding Dexterity, StringFormat='{0:F0}'}"/>
               <Label Text="{Binding Intelligence, StringFormat='{0:F0}'}"/>

               <Label  Text="{Binding TotalPower, StringFormat='Power: {0}'}"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       />
               </VerticalStackLayout>
           </Frame>
           
           <Button 
               Clicked="OnRandomiseClicked"
               Text="Random"
               />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
